                    "html": "\n<form onsubmit=\"event.preventDefault(); this.querySelector('button').textContent='Request Received \u2713';\" style=\"background:#FFFFFF; border:1px solid #E2ECE5; border-radius:16px; padding:32px; font-family:'Plus Jakarta Sans',sans-serif;\">\n  <div style=\"margin-bottom:14px;\">\n    <label style=\"display:block; font-size:12.5px; font-weight:700; color:#0B1210; margin-bottom:6px;\">Your Name</label>\n    <input type=\"text\" placeholder=\"Full Name\" required style=\"width:100%; padding:11px 14px; border:1px solid #E2ECE5; border-radius:8px; font-size:14px; box-sizing:border-box;\">\n  </div>\n  <div style=\"margin-bottom:14px;\">\n    <label style=\"display:block; font-size:12.5px; font-weight:700; color:#0B1210; margin-bottom:6px;\">Business Email</label>\n    <input type=\"email\" placeholder=\"name@company.com\" required style=\"width:100%; padding:11px 14px; border:1px solid #E2ECE5; border-radius:8px; font-size:14px; box-sizing:border-box;\">\n  </div>\n  <div style=\"margin-bottom:14px;\">\n    <label style=\"display:block; font-size:12.5px; font-weight:700; color:#0B1210; margin-bottom:6px;\">Destination Countries & Volume</label>\n    <textarea rows=\"3\" placeholder=\"Tell us your target countries and monthly SMS volume\" required style=\"width:100%; padding:11px 14px; border:1px solid #E2ECE5; border-radius:8px; font-size:14px; resize:none; box-sizing:border-box;\"></textarea>\n  </div>\n  <button type=\"submit\" style=\"width:100%; background:#3ECB5F; color:#062009; font-weight:700; font-size:14.5px; padding:13px; border:none; border-radius:999px; cursor:pointer;\">\n    Submit Interconnect Request\n  </button>\n</form>\n"
