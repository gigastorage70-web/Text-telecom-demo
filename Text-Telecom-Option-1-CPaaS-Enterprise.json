                  "isInner": false,
                  "widgetType": "html",
                  "settings": {
                    "html": "\n<div style=\"background:#FFFFFF; border:1px solid #E2ECE5; border-radius:18px; box-shadow:0 16px 40px rgba(11,18,16,0.08); overflow:hidden; font-family:'Plus Jakarta Sans',sans-serif;\">\n  <div style=\"background:#FAFCFA; border-bottom:1px solid #E2ECE5; padding:12px 18px; display:flex; justify-content:space-between; align-items:center;\">\n    <div style=\"display:flex; gap:6px;\">\n      <span style=\"background:#FFFFFF; border:1px solid #E2ECE5; padding:4px 10px; border-radius:6px; font-size:12px; font-weight:700; color:#0B1210;\">cURL / REST API</span>\n      <span style=\"padding:4px 10px; font-size:12px; font-weight:600; color:#53645B;\">SMPP 3.4 Bind</span>\n    </div>\n    <div style=\"display:inline-flex; align-items:center; gap:6px; background:#EBF9EF; padding:4px 10px; border-radius:999px; font-size:11.5px; font-weight:700; color:#126328;\">\n      <span style=\"width:6px; height:6px; border-radius:50%; background:#3ECB5F; display:inline-block;\"></span> 99.99% Operational\n    </div>\n  </div>\n  <div style=\"background:#0B1210; padding:20px; color:#E6ECE8; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.6;\">\n    <div style=\"color:#5FE07A; font-weight:600;\">POST https://api.text-telecom.com/v2/sms/send</div>\n    <div style=\"color:#A0B2A6;\">Authorization: Bearer tt_live_sec_99482</div>\n    <div style=\"color:#FED06D; margin-top:8px;\">{ \"to\": \"+971501234567\", \"sender\": \"TextTelecom\", \"text\": \"Your OTP is 849201\" }</div>\n    <div style=\"color:#5FE07A; margin-top:12px;\">// Delivery status: DELIVRD (latency: 142ms)</div>\n  </div>\n  <div style=\"background:#FAFCFA; border-top:1px solid #E2ECE5; padding:12px 18px; display:flex; justify-content:space-between; font-size:12px; color:#53645B;\">\n    <div>Dubai Hub: <strong style=\"color:#126328;\">12ms</strong></div>\n    <div>Frankfurt DE-CIX: <strong style=\"color:#126328;\">24ms</strong></div>\n    <div>Singapore SG1: <strong style=\"color:#126328;\">31ms</strong></div>\n  </div>\n</div>\n"
                  },
                  "elements": []
